# --- Demo (default): no external services needed -------------------------
# Seeded sample accounts + role switcher. In-process database (PGlite) when
# DATABASE_URL is empty. Resets on every server restart.
DEMO_MODE=true

# Signs the local session cookie. Required in production outside demo mode.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Anthropic (server only) — optional; everything has a non-AI fallback ---
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Supabase (pilot) ------------------------------------------------------
# Auth (anonymous workers + magic link) is used when these are set AND
# DEMO_MODE is not "true". DATABASE_URL = the project's Postgres connection
# string (Settings → Database); queries run with RLS via role + JWT claims.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
